#!/usr/bin/env bash
#
# embodi - EMBODIOS build and management tool
#
# Usage:
#   embodi run [--iso] [--uefi] [--memory SIZE]   Build (if needed) and run in QEMU
#   embodi build [--debug] [--model PATH]         Build kernel with embedded model
#   embodi iso [--model PATH] [--output PATH]     Create hybrid BIOS+UEFI ISO
#   embodi release                                Assemble release artifacts in dist/
#   embodi pull [MODEL ...]                       Download AI models (default: smollm)
#   embodi clean                                  Clean build artifacts
#   embodi test [--boot]                          Run kernel tests (+ boot smoke test)
#   embodi help                                   Show this help
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KERNEL_DIR="$SCRIPT_DIR/kernel"
BUILD_DIR="$SCRIPT_DIR/build"
DIST_DIR="$SCRIPT_DIR/dist"
MODELS_DIR="$SCRIPT_DIR/models"

# Colors (disable if not tty)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

log()   { echo -e "${GREEN}[embodi]${NC} $*"; }
warn()  { echo -e "${YELLOW}[embodi]${NC} $*"; }
error() { echo -e "${RED}[embodi]${NC} $*" >&2; }
die()   { error "$@"; exit 1; }

# Single source of truth for the version string
kernel_version() {
    grep -oP 'kernel_version = "\K[^"]+' "$KERNEL_DIR/core/kernel.c" 2>/dev/null || echo "unknown"
}

# Default model: env override, then repo models dir, then /tmp/models
default_model() {
    if [ -n "${GGUF_MODEL:-}" ] && [ -f "$GGUF_MODEL" ]; then
        echo "$GGUF_MODEL"
    elif [ -f "$MODELS_DIR/smollm-135m-instruct-q4_k_m.gguf" ]; then
        echo "$MODELS_DIR/smollm-135m-instruct-q4_k_m.gguf"
    elif [ -f /tmp/models/smollm-135m-instruct-q4_k_m.gguf ]; then
        echo /tmp/models/smollm-135m-instruct-q4_k_m.gguf
    else
        echo ""
    fi
}

find_qemu() {
    if [ -n "${QEMU_BIN:-}" ] && [ -x "$QEMU_BIN" ]; then
        echo "$QEMU_BIN"
    elif command -v qemu-system-x86_64 &>/dev/null; then
        command -v qemu-system-x86_64
    else
        die "qemu-system-x86_64 not found. Install QEMU or run: . \$HOME/env.sh"
    fi
}

# Locate OVMF firmware (sysroot first, then common distro paths)
find_ovmf() {
    # Note: OVMF_CODE_4M.fd needs a separate VARS flash and does NOT work
    # with plain -bios; the 2M combined/standalone images do.
    local candidates=(
        "${SYSROOT:-$HOME/sysroot}/usr/share/OVMF/OVMF_CODE.fd"
        "${SYSROOT:-$HOME/sysroot}/usr/share/ovmf/OVMF.fd"
        "${SYSROOT:-$HOME/sysroot}/usr/share/qemu/OVMF.fd"
        /usr/share/OVMF/OVMF_CODE.fd
        /usr/share/ovmf/OVMF.fd
        /usr/share/qemu/OVMF.fd
    )
    for f in "${candidates[@]}"; do
        [ -f "$f" ] && { echo "$f"; return 0; }
    done
    return 1
}

usage() {
    cat <<EOF
EMBODIOS Build Tool ($(kernel_version))

Usage: embodi <command> [options]

Commands:
  run               Build (if needed) and run in QEMU          [main UX]
  build             Build the kernel with embedded model
  iso               Create hybrid BIOS+UEFI bootable ISO
  release           Assemble release artifacts in dist/
  pull              Download AI models (default: smollm)
  clean             Clean build artifacts
  test              Run kernel tests (--boot adds QEMU boot smoke test)
  help              Show this help

Run Options:
  embodi run [--memory SIZE] [--iso] [--uefi] [--tui]
    --memory SIZE   Memory size (default: 1024M)
    --iso           Boot from dist/embodios.iso (CD-ROM) instead of -kernel
    --uefi          Boot with OVMF UEFI firmware instead of SeaBIOS
    --tui           Keep the QEMU display window (default: -display none, serial stdio)

  Default: qemu-system-x86_64 -kernel kernel/embodios.elf -m 1024M -serial stdio -display none

Build Options:
  embodi build [--debug] [--model PATH]
    --debug         Build with debug symbols
    --model PATH    GGUF model to embed (default: $GGUF_MODEL env, repo models/, /tmp/models)

ISO Options:
  embodi iso [--model PATH] [--output PATH]
    --model PATH    Path to GGUF model file (optional)
    --output PATH   Output ISO (default: dist/embodios.iso)

Examples:
  embodi run                          # Build if needed, run kernel in QEMU
  embodi run --iso                    # Boot the hybrid ISO in QEMU (BIOS)
  embodi run --iso --uefi             # Boot the ISO under UEFI (OVMF)
  embodi iso                          # Hybrid ISO with embedded model -> dist/
  embodi release                      # dist/: elf + iso + QUICKSTART.txt + VERSION
  embodi test --boot                  # Unit tests + 60s QEMU boot smoke test

EOF
}

cmd_build() {
    local debug=0
    local model=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug|-d) debug=1; shift ;;
            --model|-m) model="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    [ -z "$model" ] && model="$(default_model)"

    log "Building kernel (EMBODIOS $(kernel_version))..."
    cd "$KERNEL_DIR"

    local mk_args=()
    if [[ $debug -eq 1 ]]; then
        mk_args+=(DEBUG=1)
    fi
    if [[ -n "$model" ]]; then
        [ -f "$model" ] || die "Model file not found: $model"
        mk_args+=("GGUF_MODEL=$model")
        log "Embedding model: $model ($(du -h "$model" | cut -f1))"
    else
        warn "No GGUF model found - building kernel WITHOUT embedded model"
        mk_args+=(GGUF_MODEL=)
    fi

    make -j2 "${mk_args[@]}"

    log "Build complete: $KERNEL_DIR/embodios.elf ($(du -h "$KERNEL_DIR/embodios.elf" | cut -f1))"
}

cmd_iso() {
    local model=""
    local arch="x86_64"
    local output="$DIST_DIR/embodios.iso"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model|-m) model="$2"; shift 2 ;;
            --output|-o) output="$2"; shift 2 ;;
            --arch|-a) arch="$2"; shift 2 ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    # Validate arch
    case "$arch" in
        x86_64) ;;
        arm64) die "arm64 ISO not supported by the release pipeline (x86_64 only)" ;;
        *) die "Unsupported architecture: $arch (supported: x86_64)" ;;
    esac

    [ -z "$model" ] && model="$(default_model)"

    log "Creating hybrid BIOS+UEFI ISO for $arch..."

    local iso_args=()
    if [[ -n "$model" ]]; then
        if [[ ! -f "$model" ]]; then
            die "Model file not found: $model"
        fi
        iso_args+=(-m "$model")
        log "Embedding model: $model"
    fi
    iso_args+=(-o "$output")

    "$SCRIPT_DIR/scripts/create_iso.sh" "${iso_args[@]}"

    log "ISO created: $output"
}

cmd_run() {
    local memory="1024M"
    local use_iso=0
    local use_uefi=0
    local tui=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --memory|-m) memory="$2"; shift 2 ;;
            --iso|-i) use_iso=1; shift ;;
            --uefi|-u) use_uefi=1; shift ;;
            --tui|-t) tui=1; shift ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    local qemu; qemu="$(find_qemu)"

    # Display defaults: serial console on stdio, no graphics window
    local display_args=(-serial stdio -display none)
    if [[ $tui -eq 1 ]]; then
        display_args=()
        warn "TUI mode: QEMU display window enabled (serial goes to vc)"
    fi

    # UEFI firmware
    local fw_args=()
    if [[ $use_uefi -eq 1 ]]; then
        local ovmf
        ovmf="$(find_ovmf)" || die "OVMF firmware not found. Run scripts/bootstrap_toolchain.sh or install the 'ovmf' package."
        fw_args=(-bios "$ovmf")
        log "UEFI firmware: $ovmf"
    fi

    if [[ $use_iso -eq 1 ]]; then
        local iso="$DIST_DIR/embodios.iso"
        if [[ ! -f "$iso" ]]; then
            warn "ISO not found: $iso - building it now ('embodi iso')"
            cmd_iso
        fi
        log "Running ISO with ${memory} RAM (Ctrl-A X to quit QEMU)..."
        exec "$qemu" -cdrom "$iso" -m "$memory" -boot d "${fw_args[@]}" "${display_args[@]}"
    else
        local kernel="$KERNEL_DIR/embodios.elf"
        if [[ ! -f "$kernel" ]]; then
            warn "Kernel not found: $kernel - building it now ('embodi build')"
            cmd_build
        fi
        log "Running kernel (PVH) with ${memory} RAM (Ctrl-A X to quit QEMU)..."
        exec "$qemu" -kernel "$kernel" -m "$memory" "${fw_args[@]}" "${display_args[@]}"
    fi
}

cmd_release() {
    log "=========================================="
    log "EMBODIOS Release Pipeline ($(kernel_version))"
    log "=========================================="

    local version; version="$(kernel_version)"
    mkdir -p "$DIST_DIR"

    # 1. Kernel with embedded model
    if [[ ! -f "$KERNEL_DIR/embodios.elf" ]]; then
        cmd_build
    else
        log "Kernel already built: $KERNEL_DIR/embodios.elf (rebuild with 'embodi build' after changes)"
    fi
    cp "$KERNEL_DIR/embodios.elf" "$DIST_DIR/embodios.elf"

    # 2. Hybrid ISO
    if [[ ! -f "$DIST_DIR/embodios.iso" ]]; then
        cmd_iso
    else
        log "ISO already present: $DIST_DIR/embodios.iso (rebuild with 'embodi iso' after changes)"
    fi

    # 3. VERSION + QUICKSTART.txt
    echo "$version" > "$DIST_DIR/VERSION"

    local qemu_hint='qemu-system-x86_64'
    cat > "$DIST_DIR/QUICKSTART.txt" <<EOF
EMBODIOS $version - Bare Metal AI OS (x86_64, SmolLM-135M embedded)
=====================================================================

1. QEMU direct kernel boot (PVH, fastest):
   $qemu_hint -kernel embodios.elf -m 1024M -serial stdio -display none

2. QEMU CD-ROM boot (BIOS / SeaBIOS):
   $qemu_hint -cdrom embodios.iso -m 1024M -serial stdio -display none

3. QEMU CD-ROM boot (UEFI / OVMF):
   $qemu_hint -bios /usr/share/OVMF/OVMF_CODE.fd -cdrom embodios.iso -m 1024M -serial stdio -display none

4. Bootable USB stick (hybrid ISO, works on BIOS and UEFI PCs):
   sudo dd if=embodios.iso of=/dev/sdX bs=4M status=progress && sync

5. One-command launcher from the repo root:
   ./embodi run          # kernel (PVH)
   ./embodi run --iso    # ISO via CD-ROM
   ./embodi run --iso --uefi
EOF

    log "=========================================="
    log "Release artifacts in $DIST_DIR:"
    ls -lh "$DIST_DIR"
    log "=========================================="
}

cmd_clean() {
    log "Cleaning build artifacts..."
    cd "$KERNEL_DIR"
    make clean
    rm -rf "$BUILD_DIR" "$DIST_DIR"
    log "Clean complete"
}

cmd_test() {
    local boot=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --boot|-b) boot=1; shift ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    log "Running tests..."
    cd "$KERNEL_DIR"
    make test

    if [[ $boot -eq 1 ]]; then
        log "Running QEMU boot smoke test..."
        "$SCRIPT_DIR/scripts/boot_smoke.sh"
    else
        log "Tip: 'embodi test --boot' also runs a 60s QEMU boot smoke test"
    fi
}

cmd_pull() {
    local models=("$@")
    if [ ${#models[@]} -eq 0 ]; then
        models=(smollm)
    fi
    [ -x "$SCRIPT_DIR/scripts/download-models.sh" ] || [ -f "$SCRIPT_DIR/scripts/download-models.sh" ] \
        || die "scripts/download-models.sh not found"
    log "Pulling models: ${models[*]}"
    bash "$SCRIPT_DIR/scripts/download-models.sh" "${models[@]}"
}

# Main
case "${1:-help}" in
    build)   shift; cmd_build "$@" ;;
    iso)     shift; cmd_iso "$@" ;;
    run)     shift; cmd_run "$@" ;;
    release) shift; cmd_release "$@" ;;
    pull)    shift; cmd_pull "$@" ;;
    clean)   shift; cmd_clean "$@" ;;
    test)    shift; cmd_test "$@" ;;
    help|-h|--help) usage ;;
    *) die "Unknown command: $1 (try 'embodi help')" ;;
esac
